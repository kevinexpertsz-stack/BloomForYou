{
    "rewrites": [
        {
            "source": "/blooms/:id",
            "destination": "/index.html"
        },
        {
            "source": "/bouquet/:id",
            "destination": "/index.html"
        },
        {
            "source": "/s/:code",
            "destination": "/api/s?id=:code"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}